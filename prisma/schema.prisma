// prisma/schema.prisma

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ============================================
// ENUMS
// ============================================

enum DocumentScope {
  METODOLOGIA      // Normas y reglas de la cátedra
  LEL_DOMINIO      // Símbolos del glosario del proyecto
  ESCENARIOS_REF   // Escenarios validados de referencia
}

enum ScenarioType {
  ACTUAL
  FUTURO
  INTEGRADOR
}

enum LELCategory {
  SUJETO
  OBJETO
  VERBO
  ESTADO
}

// ============================================
// DOCUMENTOS E INGESTA
// ============================================

model Document {
  id          String        @id @default(cuid())
  title       String
  scope       DocumentScope @default(METODOLOGIA)
  content     String        @db.Text
  filePath    String?
  
  uploadedAt  DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  embeddings  Embedding[]
  
  @@index([scope, uploadedAt])
}

model Embedding {
  id          String    @id @default(cuid())
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  content     String    @db.Text
  vector      Unsupported("vector(384)")
  
  metadata    Json?
  
  createdAt   DateTime  @default(now())
  
  @@index([documentId])
}

// ============================================
// ESCENARIOS (Estructura Parseada + Validación)
// ============================================

model Scenario {
  id          String        @id @default(cuid())
  
  title       String
  type        ScenarioType  @default(ACTUAL)
  
  objective   String        @db.Text
  
  contextGeo      String?
  contextTime     String?
  contextPrecond  String?
  
  actors      String[]
  resources   String[]
  
  episodes    Json
  exceptions  Json?
  
  rawMarkdown String        @db.Text
  
  lelSymbolsUsed    String[]
  
  isValid     Boolean       @default(false)
  validationReport Json?
  
  retrievedLelSymbols  Json?
  retrievedRules       Json?
  geminiResponse       String?   @db.Text
  
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  @@index([type, isValid])
  @@index([createdAt])
}

// ============================================
// USUARIOS
// ============================================

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  
  scenarios Scenario[]
  
  createdAt DateTime   @default(now())
}
