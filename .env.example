PORT=3000
NODE_ENV=development

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/rag_escenarios_lel?schema=public"

# Configuración Agnóstica de LLM
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-2.5-flash"
LLM_TEMPERATURE="0.1"
LLM_MAX_TOKENS="8192"

# Embedding Configuration
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# API Keys por proveedor (cada uno llena la que usa)
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

